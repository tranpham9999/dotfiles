# OpenProject MCP + op-logtime skill — required
# Copy to ~/.config/opencode/.env and fill in.
# (install.sh does the copy automatically; the .env file is gitignored)
OP_BASE_URL=https://openproject.example.com
OP_API_KEY=replace-me

